# Copy to Frontend/.env.local. Only public values belong here — VITE_* vars are bundled into the browser.
# Never put database, LLM or email credentials in this file.
VITE_API_BASE_URL=http://localhost:8000

# React Bits Pro registry (used only by the shadcn CLI when installing licensed blocks; never bundled).
# Put the real key in Frontend/.env.local (gitignored), not here.
# REACTBITS_LICENSE_KEY=your-license-key-here
